# The cfo descriptor, shared by EVERY instance registered against this repo.
# Deployment comes from plow-pbc/agent-mgr; this file carries only what is true
# for all of them.
#
# Note what is NOT here: AGENT_HOME, AGENT_CONTAINER and AGENT_PROJECT. agent-mgr
# derives all three from the registry name, which is what lets any number of
# people run their own instance from one checkout. Declaring one would pin every
# instance to it, and agent-mgr's ownership guard would then refuse every
# instance but that one.
#
# No AGENT_TZ either, and for this agent that omission is load-bearing rather
# than tidy. A shared descriptor holds ONE value, so a zone here would be given
# to everyone -- and this agent decides which DAY, and on the 31st which MONTH,
# a transaction belongs to. One wrong zone closes two months wrong for every
# instance at once.
#
# The zone is per-person and it lives in ONE place: the ledger, written by
# `money.py config timezone` when the agent asks the owner what city they are
# in. Nothing here, and nothing in the home's .env, has to agree with it -- the
# brief follows it through brief_gate.py rather than through the container's
# clock, so an owner in Tokyo is set up by answering a question in a chat
# instead of by an operator editing a dotenv they will never see.

AGENT_CONFIG=config.yaml

# Installs the cron gate into the home. hermes accepts a cron script only as a
# real file inside HERMES_HOME/scripts -- not absolute, not a symlink, not a
# bind mount -- so this is the one piece of this repo that is copied rather
# than mounted. The hook says why in full.
AGENT_DEPLOY_HOOK=scripts/deploy-hook.sh

# One hourly tick, gated. The gate (cfo-shared/scripts/brief_gate.py) opens
# only on the owner's own brief hours and answers every other tick with
# `{"wakeAgent": false}`, which the scheduler reads as "skip the agent" -- no
# model run, no delivery. A cron expression cannot do this: it fires in the
# container's zone, which agent-mgr defaults to America/Los_Angeles for the
# whole fleet and which belongs to nobody.
AGENT_CRON_SPEC=runtime-cron.json

# Every instance runs a real person's money, and the gateway messages its owner
# on restart -- so a transition is user-visible. agent-mgr asks [y/N] before
# up/restart/down; automation that means it passes AGENT_TRANSITION_ACK=1.
AGENT_LIVE=1
